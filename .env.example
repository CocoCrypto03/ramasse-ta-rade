# Copier ce fichier en .env.local et remplir si vous avez un projet Supabase.
# Sans ces deux variables, l'application utilise un stockage en mémoire
# pré-rempli avec les données de démonstration (pratique en développement).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Code requis pour créer une collecte (US-04) et saisir un bilan (US-05).
# Par défaut en développement : GOELAND29
AMBASSADEUR_CODE=GOELAND29
